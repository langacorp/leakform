#!/bin/sh
# leakform pre-commit hook — stop a secret before it is committed.
#
# The scanner reads a history that already contains the secret. This reads the
# staged content, which is the only moment the value can still be kept out:
# once committed it is in the history for good, and rewriting history does not
# revoke it.
#
#   cp hooks/pre-commit .git/hooks/pre-commit && chmod +x .git/hooks/pre-commit
#
# Skipped deliberately, never silently:  git commit --no-verify
#
# POSIX sh and awk. One pass per file. No temporary files: a hook that writes
# a world-readable file in /tmp to hold what it found about secrets has missed
# the point.

set -u

MAX_BYTES=${LEAKFORM_MAX_BYTES:-1048576}

# The staged files: added, copied, modified or changed in type. --no-renames,
# because a rename that also edits the file is otherwise an R, and R was not
# in the filter: the new content went through unread. core.quotePath=false,
# because a name with a non-ASCII letter otherwise arrives in quotes and
# octal escapes, and git show could not find it.
#
# A failure here is not "nothing staged": it is nothing inspected.
if ! files=$(git -c core.quotePath=false diff --cached --name-only \
    --no-renames --diff-filter=ACMT --); then
  printf 'leakform: could not list the staged files: nothing was inspected.\n' >&2
  printf '          Commit with --no-verify to skip the check deliberately.\n' >&2
  exit 1
fi
[ -n "$files" ] || exit 0

# Un solo awk per file: tutte le forme in un passaggio, piu una prova di
# entropia per i segreti che non hanno una forma nota. Stampa posizione e
# categoria, mai il valore.
#
# Nessuna espressione a intervallo ({n,}) nel programma: mawk 1.3.4-20200120,
# l'awk di default su Debian 11 e 12 e Ubuntu 22.04, le ignora, e
# mawk 1.3.4-20240123 (Ubuntu 24.04) sbaglia [classe]{n,} seguita da altro.
# Con gli intervalli il gancio non trovava niente e lasciava passare tutto.
# Le lunghezze minime si contano nel codice, dopo match().
scan() {
  git cat-file blob ":$1" | awk -v file="$1" '
    BEGIN {
      # etichetta, espressione regolare estesa, lunghezza minima del match
      n = 0
      p[++n] = "PEM private key";       r[n] = "-----BEGIN[A-Z ]*PRIVATE KEY-----";  m[n] = 0
      p[++n] = "GitHub token";          r[n] = "gh[pousr]_[A-Za-z0-9]+";             m[n] = 34
      p[++n] = "Google API key";        r[n] = "AIza[0-9A-Za-z_-]+";                 m[n] = 34
      p[++n] = "Slack token";           r[n] = "xox[abprs]-[0-9A-Za-z-]+";           m[n] = 15
      p[++n] = "AWS access key";        r[n] = "AKIA[0-9A-Z]+";                      m[n] = 20
      p[++n] = "private key block";     r[n] = "PRIVATE KEY-----";                   m[n] = 0
      forms = n
    }

    function hit(label) { print "HIT\t" file "\t" NR "\t" label }

    # il primo match di rx in s lungo almeno min caratteri
    function longest(s, rx, min) {
      while (match(s, rx)) {
        if (RLENGTH >= min) return 1
        s = substr(s, RSTART + RLENGTH)
      }
      return 0
    }

    # 1 - le forme note
    {
      for (i = 1; i <= forms; i++)
        if (longest($0, r[i], m[i])) hit(p[i])
    }

    # URI con credenziali: una password di almeno 6 caratteri
    {
      s = $0
      while (match(s, "[a-z][a-z0-9+.-]+://[^:/@ \t]+:[^@/ \t]+@")) {
        u = substr(s, RSTART, RLENGTH)
        s = substr(s, RSTART + RLENGTH)
        sub(/^[^:]*:[^:]*:/, "", u)
        if (length(u) - 1 >= 6) { hit("URI with credentials"); break }
      }
    }

    # JWT: due segmenti di almeno 10 caratteri dopo eyJ
    {
      s = $0
      while (match(s, "eyJ[A-Za-z0-9_-]+[.]eyJ[A-Za-z0-9_-]+[.]")) {
        t = substr(s, RSTART, RLENGTH)
        s = substr(s, RSTART + RLENGTH)
        split(t, seg, ".")
        if (length(seg[1]) >= 13 && length(seg[2]) >= 13) { hit("JWT"); break }
      }
    }

    # 2 - le forme che non conosciamo.
    # Un segreto non sta solo dove ha un prefisso noto. Qui si guarda la
    # FORMA di quello che viene assegnato: un valore lungo, con molti
    # caratteri distinti, accanto a un nome che promette un segreto.
    function variety(s,   i, c, seen, k) {
      k = 0
      for (i = 1; i <= length(s); i++) {
        c = substr(s, i, 1)
        if (!(c in seen)) { seen[c] = 1; k++ }
      }
      return k
    }

    tolower($0) ~ /(secret|passwd|password|token|api[_-]?key|private[_-]?key|credential)/ {
      line = $0
      # 047 ottale = apostrofo, scritto cosi per non chiudere le virgolette di sh
      while (match(line, /["\047=: ][A-Za-z0-9+\/=_-]+/)) {
        tok  = substr(line, RSTART + 1, RLENGTH - 1)
        line = substr(line, RSTART + RLENGTH)
        if (length(tok) < 20) continue
        # lunga ma povera di caratteri distinti = e un nome, non un segreto
        if (variety(tok) >= 12 && tok !~ /^[A-Za-z_]+$/) {
          hit("high-variety value near a secret name")
          break
        }
      }
    }

  '
}

# Nessun file temporaneo: lo stream passa una volta sola, e il conteggio vive
# nello stesso processo che decide. Nel gancio precedente il contatore stava
# in una pipeline, quindi in un sottoprocesso, e fuori valeva sempre zero.
hits=0
skipped=0
report=""

# Un nome per riga, e nient'altro: niente divisione sugli spazi, niente
# espansione di * o ?. Prima "my notes.txt" diventava "my" e "notes.txt",
# nessuno dei due nell'indice, e il file passava senza essere letto.
set -f
old_ifs=$IFS
IFS='
'
for f in $files; do
  IFS=$old_ifs
  # Un nome che git restituisce ancora tra virgolette (a capo, tabulazione,
  # virgolette nel nome) non si puo leggere da qui: si dichiara.
  case $f in
    \"*) skipped=$((skipped + 1)); continue ;;
  esac
  # Dimensione e binario si misurano fuori da awk: il NUL non e portabile.
  # In awk BWK (quello di macOS) "\000" e la stringa vuota e /\x00/ trova
  # tutto, quindi ogni file risultava binario e nessuno veniva letto.
  size=$(git cat-file -s ":$f" 2>/dev/null) || size=""
  case $size in
    ""|*[!0-9]*) skipped=$((skipped + 1)); continue ;;
  esac
  if [ "$size" -gt "$MAX_BYTES" ]; then
    skipped=$((skipped + 1)); continue
  fi
  nul=$(git cat-file blob ":$f" | tr -dc '\000' | wc -c)
  if [ "$nul" -gt 0 ]; then
    skipped=$((skipped + 1)); continue
  fi
  out=$(scan "$f")
  [ -n "$out" ] || continue
  n=$(printf '%s\n' "$out" | grep -c '^HIT' || true)
  if [ "$n" -gt 0 ]; then
    hits=$((hits + n))
    report="$report$out
"
  fi
done
IFS=$old_ifs
set +f

# Un file non esaminato che non produce riscontri e' indistinguibile da un
# file pulito. La copertura si dichiara sempre, anche quando si passa.
if [ "$hits" -eq 0 ]; then
  [ "$skipped" -gt 0 ] && printf 'leakform: %d file not inspected (binary, unreadable, or over %s bytes)\n' \
    "$skipped" "$MAX_BYTES" >&2
  exit 0
fi

RED=""; OFF=""
if [ -t 2 ]; then RED=$(printf '\033[31m'); OFF=$(printf '\033[0m'); fi

printf '\n%sleakform: %d secret-shaped value(s) in the staged content%s\n\n' \
  "$RED" "$hits" "$OFF" >&2

printf '%s' "$report" | while IFS='	' read -r kind file line label; do
  [ "$kind" = "HIT" ] && printf '  %s:%s  %s\n' "$file" "$line" "$label" >&2
done

[ "$skipped" -gt 0 ] && printf '\n  (%d file not inspected: binary, unreadable, or over %s bytes)\n' \
  "$skipped" "$MAX_BYTES" >&2

cat >&2 <<'MSG'

The value is not printed: knowing where is enough to remove it.

  false positive   -> git commit --no-verify
  real secret      -> remove it, and treat the value as already out.
                      Rotating does not withdraw a value that has been read.
MSG

exit 1
